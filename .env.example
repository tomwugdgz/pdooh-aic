# ============================================================
# 环境变量示例 —— 复制为 data/tunnel.env 后按需修改
#   cp .env.example data/tunnel.env && chmod 600 data/tunnel.env
# systemd 单元 scripts/pdooh-proxy.service 通过 EnvironmentFile 读取它
# ============================================================

# 公网隧道的访问凭证（Basic Auth 用户名 / 口令）
AUTH_USER=pdooh
AUTH_PASS=change-me-to-a-strong-password

# 免登录访问用的 token（可留空则关闭 token 方式）
AUTH_TOKEN=change-me-to-a-random-token

# 鉴权代理监听端口（仅监听 127.0.0.1，由 cloudflared 回源）
PROXY_PORT=5004

# 上游业务应用地址
UPSTREAM=http://127.0.0.1:5003
